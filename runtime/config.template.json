  "rules": [
    {
      "id": "r115-default-claude-completed",
      "enabled": true,
      "description": "Claude Stop → 提醒我回來看",
      "when": {
        "provider": "claude",
        "event": "Stop",
        "state_to": "Completed"
      },
      "then": [
        {
          "kind": "toast",
          "title": "✅ Claude 完成",
          "body": "{project_name}"
        },
        {
          "kind": "sound",
          "clip": "claude.mp3",
          "volume": 1
        }
      ]
    },
    {
      "id": "r115-default-waiting-toast",
      "enabled": true,
      "description": "任何 provider 進入 WaitingForUser → toast",
      "when": {
        "provider": null,
        "event": null,
        "state_to": "StartedWaiting"
      },
      "then": [
        {
          "kind": "toast",
          "title": "⏳ {provider} 在等你回",
          "body": "{project_name}"
        }
      ]
    },
    {
      "id": "r115-default-failure-log",
      "enabled": true,
      "description": "任何 provider PostToolUseFailure → 寫 log",
      "when": {
        "provider": null,
        "event": "PostToolUseFailure",
        "state_to": null
      },
      "then": [
        {
          "kind": "log",
          "file": "~/.lobsterpulse/audit.jsonl",
          "format": "jsonl"
        }
      ]
    }
  ],
  "rules_enabled": true
}
