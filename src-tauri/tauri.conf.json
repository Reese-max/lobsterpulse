{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "額度監控",
  "version": "0.5.4",
  "identifier": "com.lobsterpulse.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "額度監控",
        "width": 300,
        "height": 46,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "zoomHotkeysEnabled": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob: data: https: http:; font-src 'self' https://fonts.gstatic.com data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "trayIcon": {
      "iconPath": "icons/128x128.png",
      "iconAsTemplate": false,
      "tooltip": "龍蝦監控"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
